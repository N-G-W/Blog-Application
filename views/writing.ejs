<%- include("partials/header.ejs") %>
<div class="writing-section">
  <form action="/publish-blog" class="blog-writing" method="post">
    <div class="heading">
      <span class="image-picker-button">+</span
      ><input type="text" name="title" class="heading" placeholder="Title..." />
    </div>
    <div class="subheading">
      <span class="image-picker-button">+</span>
      <input
        type="text"
        name="subtitle"
        class="subheading"
        placeholder="Subtitle..."
      />
    </div>
    <div class="content">
      <span class="image-picker-button">+</span>
      <input
        type="text"
        name="content"
        class="content"
        placeholder="Tell your story..."
      />
    </div>
    <div class="content">
      <span class="image-picker-button">+</span>
      <input
        type="text"
        name="content"
        class="content"
        placeholder="Tell your story..."
      />
    </div>
    <div class="content">
      <span class="image-picker-button">+</span>
      <input
        type="text"
        name="content"
        class="content"
        placeholder="Tell your story..."
      />
    </div>

    <!-- <div class="image-picker-container">
      <label for="file"> Please pick an image! </label>
      <input id="file" type="file" name="file" />
    </div> -->

    <div class="submit-button">
      <div class="center">
        <input type="submit" value="Publish" />
      </div>
    </div>
  </form>
</div>

<%- include("partials/footer.ejs") %>
<script>
  function createImagePicker() {
    let imagePicker = document.createElement("div");
    let label = document.createElement("label");
    let input = document.createElement("input");
    imagePicker.classList.add("image-picker-container");
    input.id = "file";
    input.type = "file";
    input.name = "file";
    label.setAttribute("for", "file");
    label.innerText = "Please pick an image!";
    imagePicker.appendChild(label);
    imagePicker.appendChild(input);
    return imagePicker;
  }

  const textInputsList = document.querySelectorAll(
    "input[type='text'][class='content']",
  );
  const textInputs = Array.from(textInputsList);
  // const imagePicker = document.querySelector("div.image-picker-container");
  const imagePicker = createImagePicker();
  console.log("This is the textinputs", textInputs);
  textInputs.forEach((element) => {
    element.addEventListener("click", function () {
      console.log(
        element.parentElement.firstElementChild.style.visibility,
        "this is the visibility",
      );
      if (
        element.parentElement.firstElementChild.classList.contains(
          "image-picker-button-hide",
        )
      ) {
        element.parentElement.firstElementChild.classList.remove(
          "image-picker-button-hide",
        );
      } else {
        element.parentElement.firstElementChild.classList.add(
          "image-picker-button-hide",
        );
      }
    });
  });
  textInputs.forEach((element) => {
    console.log(element.previousSibling);
    element.parentElement.firstElementChild.addEventListener(
      "click",
      function () {
        console.log(element.parentElement.nextElementSibling);
        if (element.parentElement.nextElementSibling.isEqualNode(imagePicker)) {
          element.parentElement.nextElementSibling.remove();
        } else {
          element.parentElement.parentElement.insertBefore(
            imagePicker,
            element.parentElement.nextElementSibling,
          );
        }
      },
    );
  });
</script>
