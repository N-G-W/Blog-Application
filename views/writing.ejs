<%- include("partials/header.ejs") %>
<div class="writing-section">
  <form action="/publish-blog" class="blog-writing" method="post">
    <div class="heading">
      <span class="image-picker-button">+</span
      ><input type="text" name="title" class="heading" placeholder="Title..." />
    </div>
    <div class="subheading">
      <span class="image-picker-button">+</span>
      <input
        type="text"
        name="subtitle"
        class="subheading"
        placeholder="Subtitle..."
      />
    </div>
    <div class="content">
      <span class="image-picker-button">+</span>
      <input
        type="text"
        name="content"
        class="content"
        placeholder="Tell your story..."
      />
    </div>

    <!-- <div class="image-picker-container">
      <label for="file"> Please pick an image! </label>
      <input id="file" type="file" name="file" />
    </div> -->

    <div class="submit-button">
      <div class="center">
        <input type="submit" value="Publish" />
      </div>
    </div>
  </form>
</div>

<%- include("partials/footer.ejs") %>
<script>
  function createImagePicker() {
    let imagePicker = document.createElement("div");
    let label = document.createElement("label");
    let input = document.createElement("input");
    imagePicker.classList.add("image-picker-container");
    input.id = "file";
    input.type = "file";
    input.name = "file";
    label.setAttribute("for", "file");
    label.innerText = "Please pick an image!";
    imagePicker.appendChild(label);
    imagePicker.appendChild(input);
    return imagePicker;
  }

  const textInputsList = document.querySelectorAll(
    "input[type='text'][class='content']",
  );
  const textInputs = Array.from(textInputsList);
  // const imagePicker = document.querySelector("div.image-picker-container");
  const imagePicker = createImagePicker();
  console.log(textInputs);
  textInputs.forEach((element) => {
    element.addEventListener("click", function () {
      console.log(element.previousSibling.previousSibling);
      element.previousSibling.previousSibling.style = "visibility: visible;";
    });
  });
  textInputs.forEach((element) => {
    console.log(element.previousSibling);
    element.previousSibling.addEventListener("click", function () {
      console.log(element.parentElement.firstChild.isEqualNode(imagePicker));
      if (element.parentElement.firstChild.isEqualNode(imagePicker)) {
        element.parentElement.removeChild(imagePicker);
      } else {
        element.parentElement.appendChild(imagePicker);
      }
    });
  });
</script>
