<%- include("partials/header.ejs") %> <%- include("partials/panel.ejs") %>
<div class="article-container">
  <% if (locals.articleContent && locals.articleContent!==[]) { %>
   <%for (const article of articleContent[0]) {%>
    <div class="article">
    <div class="article-heading">
      <%= article['title'] %>
    </div>
    <div class="article-subheading">
      <%= article['subtitle'] %>
    </div>
    <div class="article-name-etc">
      <div class="pfp-name-container">
        <img src="icons/person.svg" alt="" class="pfp" />
        <div class="pfp-name">John Doe</div>
      </div>
    </div>
    <div class="article-buttons-section">
      <div class="card-buttons-container">
        <div class="left">
          <div class="card-button">
            <img src="icons/stars.svg" alt="icon" />
          </div>
          <div class="card-button">
            <img src="icons/hand-thumbs-up.svg" alt="icon" />
          </div>
          <div class="card-button">
            <img src="icons/chat.svg" alt="icon" />
          </div>
        </div>
        <div class="right">
          <div class="card-button">
            <img src="icons/hand-thumbs-down.svg" alt="icon" />
          </div>
          <div class="card-button">
            <img src="icons/bookmark-heart.svg" alt="icon" />
          </div>
          <div class="card-button">
            <img src="icons/three-dots.svg" alt="icon" />
          </div>
        </div>
      </div>
    </div>

    <div class="article-image">
       <img src= <%= article['paths'] %> alt="image" class="image-contract" /> 
      
    </div>
    <% for (const paragraph of article['content']) { %>
      <p class="article-paragraph-normal">
      <%= paragraph %>
    </p>
    <%} %>

    
    <!-- <p class="article-paragraph-bold">
      Lorem ipsum dolor sit amet consectetur, adipisicing elit. Voluptate
      voluptas vitae consequuntur autem non fuga, iste recusandae nostrum
      delectus praesentium?
    </p> -->
    
  </div>
  <%}%>
  <% } %>
</div>
<script>
  const image = document.querySelector(".article-image>img");
  image.addEventListener("click", function () {
    if (image.classList.contains("image-expand")) {
      image.classList.remove("image-expand");
      image.classList.add("image-contract");
    } else {
      image.classList.add("image-expand");
      image.classList.remove("image-contract");
    }
  });
</script>
<%-include("partials/footer.ejs") %>
