<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SemiBold</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="styles/index.css" />
    <link rel="shortcut icon" href="icons/favicon.png" type="image/x-icon" />
  </head>
  <body>
    <header>
      <div class="logo">
        <span class="semi">Semi</span><span class="bold">Bold</span>
      </div>
      <div class="search-bar">SearchBar</div>
      <div class="icons">
        <div class="icon">Icon</div>
        <div class="icon">Icon</div>
        <div class="icon">Icon</div>
        <div class="icon">Icon</div>
      </div>
    </header>
    <main class="main-container">
      <div class="side-panel">
        <div class="panel-buttons">
          <img src="icons/house.svg" alt="house" /> Home
        </div>
        <div class="panel-buttons">
          <img src="icons/person.svg" alt="person" /> Profile
        </div>
        <div class="panel-buttons">
          <img src="icons/pen.svg" alt="Pen" /> Write
        </div>
        <div class="panel-buttons">
          <img src="icons/collection.svg" alt="page" /> Collection
        </div>
      </div>
      <div class="main-content">
        <div class="card">Card</div>
        <div class="card">Card</div>
        <div class="card">Card</div>
      </div>
      <div class="recommendation-panel">
        <div class="small-card">Smaller Card</div>
        <div class="small-card">Smaller Card</div>
        <div class="small-card">Smaller Card</div>
        <div class="small-card">Smaller Card</div>
        <div class="small-card">Smaller Card</div>
        <div class="small-card">Smaller Card</div>
      </div>
    </main>

    <footer>© SemiBold 2026</footer>
  </body>
</html>
