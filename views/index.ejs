<%- include("partials/header.ejs") %>

<main class="main-container">
  <%- include("partials/panel.ejs") %>
  <div class="main-content">
    <div class="card-container">
      <div class="card">
        <div class="card-content-container">
          <div class="pfp-name-container">
            <img src="icons/person.svg" alt="" class="pfp" />
            <div class="pfp-name">John Doe</div>
          </div>
          <div class="card-title">Oh no! Something Obvious !!??</div>
          <div class="card-subtitle">
            I did a thing. Then did another thing.
          </div>
          <div class="card-buttons-container">
            <div class="left">
              <div class="card-button">
                <img src="icons/stars.svg" alt="icon" />
              </div>
              <div class="card-button">
                <img src="icons/hand-thumbs-up.svg" alt="icon" />
              </div>
              <div class="card-button">
                <img src="icons/chat.svg" alt="icon" />
              </div>
            </div>
            <div class="right">
              <div class="card-button">
                <img src="icons/hand-thumbs-down.svg" alt="icon" />
              </div>
              <div class="card-button">
                <img src="icons/bookmark-heart.svg" alt="icon" />
              </div>
              <div class="card-button">
                <img src="icons/three-dots.svg" alt="icon" />
              </div>
            </div>
          </div>
        </div>
        <div class="card-image">
          <img src="icons/favicon.png" alt="" class="card" />
        </div>
      </div>
    </div>
  </div>
  <div class="recommendation-panel">
    <div class="small-card">
      <div class="small-card-content-container">
        <div class="pfp-name-container">
          <img src="icons/favicon.png" alt="" class="pfp" />
          <div class="pfp-name">John Doe</div>
        </div>
        <div class="small-card-title">Oh no! Something Obvious !!??</div>
        <div class="card-buttons-container">
          <div class="small-card-button">
            <img src="icons/favicon.png" alt="icon" />
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include("partials/footer.ejs") %>
