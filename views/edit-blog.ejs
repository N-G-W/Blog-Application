<%- include("partials/header.ejs") %>
<script>
  function createArticleImage(filePath) {
    let div = document.createElement("div");
    div.classList.add("article-image");
    let img = document.createElement("img");
    img.classList.add("image-contract");
    img.setAttribute("src", filePath);
    img.setAttribute("alt", "image");
    div.appendChild(img);
    img.addEventListener("click", function () {
      if (img.classList.contains("image-expand")) {
        img.classList.remove("image-expand");
        img.classList.add("image-contract");
      } else {
        img.classList.add("image-expand");
        img.classList.remove("image-contract");
      }
    });
    return div;
  }
  function previewImage(event) {
    const files = event.srcElement.files;
    const imagePicker = document.querySelector("div.image-picker-container");

    if (files.length === 0) {
      imagePicker.style = "visibility:collapse;height:0;";
    } else if (files.length === 1) {
      let img = createArticleImage(URL.createObjectURL(files[0]));
      imagePicker.parentElement.insertBefore(img, imagePicker.nextSibling);
      imagePicker.style = "visibility:collapse;height:0;";
    } else {
      for (const file of files) {
        let img = createArticleImage(URL.createObjectURL(file));
        imagePicker.parentElement.insertBefore(img, imagePicker.nextSibling);
      }
      imagePicker.style = "visibility:collapse;height:0;";
    }
    return;
    // imagePicker.parentElement.insertBefore(img, imagePicker.nextSibling);
    // imagePicker.style = "visibility:collapse;height:0;";
    // console.log(event);
  }
  function createImagePicker() {
    let imagePicker = document.createElement("div");
    let label = document.createElement("label");
    let input = document.createElement("input");
    imagePicker.classList.add("image-picker-container");
    input.id = "file";
    input.type = "file";
    input.name = "file";
    label.setAttribute("for", "file");
    label.innerText = "Please pick an image!";
    imagePicker.appendChild(label);
    imagePicker.appendChild(input);
    imagePicker.addEventListener("change", previewImage);
    return imagePicker;
  }
</script>
  <% if (locals.existingArticle && locals.existingArticle!==null) { %>
