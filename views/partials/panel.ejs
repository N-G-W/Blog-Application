<div class="fixed-panel-container">
  <div class="side-panel">
    <div class="panel-buttons">
      <img src="icons/house.svg" alt="house" /> Home
    </div>
    <div class="panel-buttons">
      <img src="icons/person.svg" alt="person" /> Profile
    </div>
    <a class="panel-link" href="/write-blog">
      <div class="panel-buttons">
        <img src="icons/pen.svg" alt="Pen" /> Write
      </div>
    </a>
    <div class="panel-buttons">
      <img src="icons/collection.svg" alt="page" /> Collection
    </div>
  </div>
</div>

<script>
  let buttons = document.querySelectorAll(".panel-buttons");
  buttons = Array.from(buttons);
  buttons[0].classList.add("panel-button-left-border");
  buttons.forEach((element) => {
    element.addEventListener("click", () => {
      let otherButtons = document.querySelectorAll(".panel-buttons");
      otherButtons = Array.from(otherButtons);
      otherButtons.forEach((button) => {
        if (element.isSameNode(button)) {
          button.classList.add("panel-button-left-border");
        } else {
          button.classList.remove("panel-button-left-border");
        }
      });
    });
  });
  console.log(buttons);
</script>
